---
import '../styles/global.css';

const { title, description, activeNav } = Astro.props;
const pageTitle = title ? `${title} · jiewuai` : 'jiewuai · 免费在线图片工具';
const pageDesc = description || '免费在线图片工具：引流图生成器、图片加噪点、二维码美化、小红书封面生成等，纯前端本地处理，免注册。';
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="jiewuai" />
</head>
<body>
  <header class="top">
    <div class="wrap top-inner">
      <a href="/" class="brand">🧰 jiewuai</a>
      <nav class="nav">
        <a href="/" class={`nav-link ${activeNav === 'home' ? 'active' : ''}`}>首页</a>
        <a href="/tools/" class={`nav-link ${activeNav === 'tools' ? 'active' : ''}`}>工具箱</a>
        <a href="/resources/" class={`nav-link ${activeNav === 'resources' ? 'active' : ''}`}>资源库</a>
        <a href="/about/" class={`nav-link ${activeNav === 'about' ? 'active' : ''}`}>关于</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap">
      <nav style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:10px;">
        <a href="/about/">关于</a>
        <a href="/privacy/">隐私政策</a>
        <a href="mailto:contact@jiewuai.com">联系：contact@jiewuai.com</a>
      </nav>
      <p>免责声明：本站所有工具均在浏览器本地运行，不上传任何数据。使用者须遵守相关平台规则与法律法规。</p>
      <p>© {year} jiewuai.com · 免费在线图片工具</p>
    </div>
  </footer>
</body>
</html>
